# Copy to .env and fill in. Never commit the real file.
# Run locally:  pnpm --filter @workspace/api-server run build && \
#               node --env-file=artifacts/api-server/.env artifacts/api-server/dist/index.mjs

PORT=3000

# Required for Leo (voice + vision). Get one at console.x.ai
XAI_API_KEY=

# Optional overrides (defaults shown)
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=ara
# XAI_VISION_MODEL=grok-4.3

# Postgres (Neon etc). If unset the server uses in-memory sessions (dev only).
DATABASE_URL=

# Enables POST /api/bridge/session for Middleman. Use a long random string.
BRIDGE_API_KEY=

# Private owner pass (>= 24 chars, long random string). Enables POST /api/owner-pass
# and the "Owner access" link: a 24h voice + vision session without Whop, stored
# with an owner_comp_ payment id. Unset = route returns 404.
OWNER_PASS=

# Web frontend origin for payment return URLs (may differ from API host).
APP_BASE_URL=

# API origin for bridge wsUrl/visionUrl. Falls back to RENDER_EXTERNAL_URL/request host.
API_PUBLIC_BASE_URL=

# Approved public Expo APK artifact URL; unset means no Android APK is advertised.
APPROVED_APK_URL=
# Download proxy currently requires Expo artifact authorization as well.
EXPO_TOKEN=

# Android music decoder. Must exist on the deployed host; never silently treat AAC as PCM.
FFMPEG_BIN=ffmpeg

# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=

# Whop (web payments)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_PLAN_AUDIO_MONTHLY=
WHOP_PLAN_FULL_MONTHLY=
WHOP_PLAN_AUDIO_SESSION=
WHOP_PLAN_FULL_SESSION=

SESSION_SECRET=
