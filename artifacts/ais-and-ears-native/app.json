{
  "expo": {
    "name": "AIs&Ears",
    "slug": "ais-and-ears-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ais-and-ears-native",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121f30"
    },
    "ios": {
      "bundleIdentifier": "com.livhappierapps.aisandears",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access lets Leo see you through the vision feed.",
        "NSMicrophoneUsageDescription": "Microphone access is needed for voice conversations with Leo.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.livhappierapps.aisandears",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#121f30"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Camera access lets you send a snapshot to Leo.",
          "photosPermission": false,
          "microphonePermission": "Microphone access is needed for voice conversations and optional music analysis."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Microphone access is needed for voice conversations and optional music analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8c8d85fb-57c4-4c5c-91cf-1cd4bc90b0f9"
      }
    },
    "owner": "livhappierapps"
  }
}
